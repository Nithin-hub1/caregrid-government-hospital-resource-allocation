# ===================================================================
# CareGrid — Government Hospital Resource Allocation System
# Example Application Configuration
# Copy this file to application.properties and configure your credentials.
# NEVER commit production passwords or JWT secrets to source control.
# ===================================================================

spring.application.name=hospital-resource-allocation
server.port=8080

# -------------------------------------------------------------------
# MySQL Database Configuration
# -------------------------------------------------------------------
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/hospital_db}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_database_password}

# -------------------------------------------------------------------
# JPA / Hibernate Configuration
# -------------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# -------------------------------------------------------------------
# JWT Authentication & Security Settings
# -------------------------------------------------------------------
# Generate a secure 256-bit (32+ character) secret for production
caregrid.jwt.secret=${CAREGRID_JWT_SECRET:ReplaceWithAStrong256BitSecretKeyForProductionDeployment2026!}
caregrid.jwt.expiration-ms=${CAREGRID_JWT_EXPIRATION_MS:86400000}

# Initial Account Bootstrap (Optional: Override default initial bootstrap passwords)
# CAREGRID_ADMIN_PASSWORD=AdminSecurePassword123!
# CAREGRID_OPERATOR_PASSWORD=OperatorSecurePassword123!
