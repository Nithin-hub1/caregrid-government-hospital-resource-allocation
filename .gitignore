# ===================================================================
# CareGrid — Comprehensive Root .gitignore
# Government Hospital Resource Allocation System
# ===================================================================

# -------------------------------------------------------------------
# Java & Maven
# -------------------------------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/
hs_err_pid*
replay_pid*

# -------------------------------------------------------------------
# Node.js & React Frontend
# -------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------------------------------------------
# IDEs & Editors
# -------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.swp
*.swo
*~
.classpath
.project
.settings/
bin/
.sts4-cache/

# -------------------------------------------------------------------
# Operating System Files
# -------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# -------------------------------------------------------------------
# Secrets & Environment Configurations
# -------------------------------------------------------------------
.env
.env.*
!.env.example
application-local.properties
application-secret.properties
*.pem
*.key
*.p12
*.jks

# -------------------------------------------------------------------
# Runtime Logs, Dumps & Scratch Scripts
# -------------------------------------------------------------------
logs/
*.log
backend/*.log
backend/backend-debug.log
backend/startup-error.txt
*.tmp
*.bak
*.dump
scratch/
